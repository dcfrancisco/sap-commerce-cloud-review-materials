{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"academy://schemas/developer-exercise-family.v1",
  "title":"Developer Testing Exercise Family",
  "type":"object",
  "required":["schemaVersion","id","version","variantPolicy","variantDimensions","exercises"],
  "properties":{
    "schemaVersion":{"const":"developer-exercise-family.v1"},
    "id":{"type":"string","pattern":"^DEV-EF-"},
    "version":{"type":"string"},
    "variantPolicy":{"type":"string","minLength":40},
    "variantDimensions":{"type":"object","minProperties":2},
    "exercises":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/exercise"}}
  },
  "$defs":{
    "exercise":{"type":"object","required":["id","moduleId","version","title","type","difficulty","estimatedMinutes","competencyIds","objective","initialState","prompt","constraints","deliverable","acceptanceCriteria","hints","evaluation","referenceSolution","sourceIds","reviewStatus","executionBoundary"],"properties":{
      "id":{"type":"string","pattern":"^DEV-EX-"},
      "moduleId":{"pattern":"^M0[2-5]$"},
      "competencyIds":{"type":"array","minItems":2,"uniqueItems":true},
      "acceptanceCriteria":{"type":"array","minItems":5},
      "hints":{"type":"array","minItems":2},
      "executionBoundary":{"type":"string","minLength":40},
      "reviewStatus":{"enum":["draft","implemented-machine-validated","human-reviewed","published"]}
    }}
  }
}
