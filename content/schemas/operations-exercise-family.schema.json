{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"academy://schemas/operations-exercise-family.v1",
  "title":"Operations Exercise Family",
  "type":"object",
  "required":["schemaVersion","id","version","moduleId","variantPolicy","variantDimensions","exercises"],
  "properties":{
    "schemaVersion":{"const":"operations-exercise-family.v1"},
    "id":{"type":"string","pattern":"^OPS-EF-"},
    "version":{"type":"string"},
    "moduleId":{"type":"string","pattern":"^OPS-D[0-9]{2}-M[0-9]{2}$"},
    "variantPolicy":{"type":"string","minLength":40},
    "variantDimensions":{"type":"object","minProperties":2},
    "exercises":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/exercise"}}
  },
  "$defs":{
    "exercise":{"type":"object","required":["id","moduleId","version","title","type","difficulty","estimatedMinutes","competencyIds","objective","initialState","prompt","constraints","deliverable","acceptanceCriteria","hints","evaluation","referenceSolution","sourceIds","reviewStatus"],"properties":{"id":{"type":"string","pattern":"^OPS-EX-"},"competencyIds":{"type":"array","minItems":1,"uniqueItems":true},"constraints":{"type":"array","minItems":2},"acceptanceCriteria":{"type":"array","minItems":4},"hints":{"type":"array","minItems":2},"reviewStatus":{"enum":["draft","implemented-machine-validated","human-reviewed","published"]}}}
  }
}
