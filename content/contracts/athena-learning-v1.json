{
  "schemaVersion":"athena-learning-contract.v1",
  "status":"standalone-contract-not-integrated",
  "resources":["CourseCatalog","ModuleMetadata","LessonDelivery","LearningSession","TutorRequest","ContentRetrieval","AssessmentSelection","AssessmentSubmission","AssessmentEvaluation","CompetencyProfile","MasteryEvidence","LearningRecommendation","ProgressReport","CoursePackage"],
  "tutorRequest":{"requestId":"string","learnerId":"string","moduleId":"string","mode":"teach|hint|explain-code|incident|architecture","question":"string","contextRefs":["source-id|lesson-id|assessment-id"]},
  "tutorResponse":{"requestId":"string","answer":"string","citations":["source-id"],"confidence":"verified|interpretation|simulation|unknown","nextAction":"string","abstainReason":"optional string"},
  "assessmentSubmission":{"attemptId":"string","itemId":"string","response":"json","evidenceRefs":["lab-run-id|code-hash|explanation-id"]},
  "rules":["Authoritative content is versioned separately from learner-private performance.","AI responses must cite retrieved content or abstain.","Deterministic grading remains separate from subjective tutor feedback.","No arbitrary learner code executes in the host process."]
}
